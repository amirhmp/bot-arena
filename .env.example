# Copy to .env and adjust. Never commit .env.

# --- Postgres ---
POSTGRES_USER=botarena
POSTGRES_PASSWORD=botarena
POSTGRES_DB=botarena
# Used by the API, the worker and Prisma when running on the host (development).
DATABASE_URL=postgresql://botarena:botarena@localhost:5432/botarena

# --- Seq (logging) ---
# Plain-text admin password, passed to Seq as SEQ_FIRSTRUN_ADMINPASSWORD.
SEQ_ADMIN_PASSWORD=change-me-seq-admin
# Host ports Seq is published on in development (compose.dev.yaml). Change them here if a port is taken.
# The API and web server derive the ingestion URL (http://localhost:<SEQ_INGESTION_PORT>) from this,
# so this is the only place the port is written.
SEQ_INGESTION_PORT=5341
SEQ_UI_PORT=8087
# Optional override of the full ingestion URL. Leave unset in development.
# Production Compose sets it to http://seq:5341 (internal network, container port is fixed).
# SEQ_URL=

# --- API ---
API_PORT=4000
LOG_LEVEL=info

# --- Auth ---
# Signs session cookies. At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-at-least-32-characters
# Origin the API is reached on (no path). Development: the API itself.
# Production Compose sets it to https://$DOMAIN.
BETTER_AUTH_URL=http://localhost:4000
# The first admin, created on API startup when no admin exists yet (there is no self-registration).
# Change the password after the first sign-in. Later changes here do nothing once an admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# --- Web ---
# Base URL the Next.js server uses to reach the API (server-side calls).
API_URL=http://localhost:4000
# Base URL the browser uses. In production Caddy serves /api on the same domain, so use "/api".
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Production only (compose.prod.yaml) ---
# Optional proxy used only while building images (pnpm install and Prisma engine downloads).
# Leave all three empty to download directly. Not used at runtime and not read by the API or web app.
# A proxy running on the Docker host is NOT reachable as localhost from inside the build:
# use http://host.docker.internal:<port> instead.
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=
DOMAIN=arena.example.com
SEQ_DOMAIN=logs.arena.example.com
