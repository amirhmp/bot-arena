// Prisma 7: the connection URL lives in prisma.config.ts, not here.
// Models are added phase by phase. Phase 1 adds the Better Auth tables (User, Session, Account,
// Verification). Field names follow Better Auth's schema plus the username and admin plugins;
// keep them in sync when upgrading better-auth. Phase 2 adds the question bank (Question, TestCase).

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  // username plugin: the login name (lowercase, unique).
  username        String? @unique
  displayUsername String?

  // admin plugin: role is "admin" or "player"; banned means deactivated.
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions  Session[]
  accounts  Account[]
  questions Question[]
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

enum Difficulty {
  easy
  medium
  hard
}

/// How output is compared with a test's expected output (decision 29).
enum ComparisonRule {
  trimmed
  strict
  token
}

model Question {
  id                String         @id @default(cuid())
  title             String
  /// MDX source, as the admin wrote it. Never sent to students.
  statementMdx      String
  /// The MDX compiled on the server at save time (decision 32). This is what students receive.
  statementCompiled String
  tags              String[]       @default([])
  difficulty        Difficulty     @default(medium)
  timeLimitMs       Int            @default(2000)
  memoryLimitMb     Int            @default(256)
  maxScore          Int            @default(10)
  comparison        ComparisonRule @default(trimmed)
  createdById       String?
  createdBy         User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tests TestCase[]

  @@index([updatedAt])
}

model TestCase {
  id             String   @id @default(cuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Display and run order within the question.
  position       Int      @default(0)
  /// Visible tests are samples students can see; hidden tests never leave the server.
  visible        Boolean  @default(false)
  stdin          String   @default("")
  expectedOutput String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([questionId, position])
}
